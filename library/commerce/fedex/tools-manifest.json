{
  "tools": [
    {
      "name": "get_rates",
      "description": "Get FedEx rate quotes for a shipment request. This calls FedEx but does not create a shipment.",
      "parameters": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "description": "Exact FedEx REST request object for this operation.",
            "properties": {"accountNumber": {"type": "object", "properties": {"value": {"type": "string"}}, "required": ["value"]}, "requestedShipment": {"type": "object", "properties": {"shipper": {"type": "object"}, "recipient": {"type": "object"}, "pickupType": {"type": "string"}, "rateRequestType": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "requestedPackageLineItems": {"type": "array", "minItems": 1, "items": {"type": "object"}}}, "required": ["shipper", "recipient", "pickupType", "rateRequestType", "requestedPackageLineItems"]}, "rateRequestControlParameters": {"type": "object"}, "carrierCodes": {"type": "array", "items": {"type": "string", "enum": ["FDXE", "FDXG"]}}},
            "required": ["accountNumber", "requestedShipment"]
          }
        },
        "required": ["request"]
      }
    },
    {
      "name": "validate_address",
      "description": "Validate and standardize an address with FedEx. This may be billable, is never retried automatically, and does not create a shipment.",
      "parameters": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "description": "Exact FedEx REST request object for this operation.",
            "properties": {"addressesToValidate": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "properties": {"address": {"type": "object"}}, "required": ["address"]}}, "inEffectAsOfTimestamp": {"type": "string"}, "validateAddressControlParameters": {"type": "object"}},
            "required": ["addressesToValidate"]
          }
        },
        "required": ["request"]
      }
    },
    {
      "name": "validate_shipment",
      "description": "Validate a single-package shipment request without creating a shipment or label.",
      "parameters": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "description": "Exact FedEx REST request object for this operation.",
            "properties": {"accountNumber": {"type": "object", "properties": {"value": {"type": "string"}}, "required": ["value"]}, "requestedShipment": {"type": "object", "properties": {"shipper": {"type": "object"}, "recipients": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}}, "serviceType": {"type": "string"}, "packagingType": {"type": "string"}, "requestedPackageLineItems": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "properties": {"groupPackageCount": {"type": "integer", "enum": [1]}}}}}, "required": ["shipper", "recipients", "serviceType", "packagingType", "requestedPackageLineItems"]}},
            "required": ["accountNumber", "requestedShipment"]
          }
        },
        "required": ["request"]
      }
    },
    {
      "name": "pickup_availability",
      "description": "Check FedEx Express or Ground pickup availability without scheduling a pickup.",
      "parameters": {
        "type": "object",
        "properties": {
          "request": {
            "type": "object",
            "description": "Exact FedEx REST request object for this operation.",
            "properties": {"pickupAddress": {"type": "object"}, "dispatchDate": {"type": "string"}, "packageReadyTime": {"type": "string"}, "customerCloseTime": {"type": "string"}, "pickupRequestType": {"type": "array", "items": {"type": "string"}}, "shipmentAttributes": {"type": "object"}, "numberOfBusinessDays": {"type": "integer", "minimum": 0}, "packageDetails": {"type": "object"}, "associatedAccountNumber": {"type": "object", "properties": {"value": {"type": "string"}}, "required": ["value"]}, "carriers": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["FDXE", "FDXG"]}}},
            "required": ["pickupAddress", "dispatchDate", "packageReadyTime", "customerCloseTime", "associatedAccountNumber", "carriers"]
          }
        },
        "required": ["request"]
      }
    },
    {
      "name": "create_label",
      "description": "Preview or, after bound confirmation, create one FedEx shipment, persist its tracking ledger entry, and write one private PDF label.",
      "parameters": {
        "type": "object",
        "properties": {
          "request": {"type": "object", "properties": {"labelResponseOptions": {"type": "string", "enum": ["LABEL"]}, "accountNumber": {"type": "object"}, "requestedShipment": {"type": "object", "properties": {"requestedPackageLineItems": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "properties": {"groupPackageCount": {"type": "integer", "enum": [1]}}}}}}}, "required": ["labelResponseOptions", "accountNumber", "requestedShipment"]},
          "confirm": {"type": "boolean", "default": false},
          "operation_id": {"type": "string"},
          "confirmation_digest": {"type": "string"}
        },
        "required": ["request"]
      }
    },
    {
      "name": "cancel_shipment",
      "description": "Preview or, after bound confirmation, cancel one FedEx shipment.",
      "parameters": {
        "type": "object",
        "properties": {
          "request": {"type": "object", "properties": {"accountNumber": {"type": "object"}, "trackingNumber": {"type": "string"}, "senderCountryCode": {"type": "string"}, "deletionControl": {"type": "string", "enum": ["DELETE_ALL_PACKAGES", "DELETE_ONE_PACKAGE"]}}, "required": ["accountNumber", "trackingNumber", "senderCountryCode", "deletionControl"]},
          "confirm": {"type": "boolean", "default": false},
          "operation_id": {"type": "string"},
          "confirmation_digest": {"type": "string"}
        },
        "required": ["request"]
      }
    },
    {
      "name": "schedule_pickup",
      "description": "Check availability, then preview or, after bound confirmation, schedule and persist one FedEx pickup.",
      "parameters": {
        "type": "object",
        "properties": {
          "request": {"type": "object", "properties": {"associatedAccountNumber": {"type": "object"}, "carrierCode": {"type": "string", "enum": ["FDXE", "FDXG"]}, "packageCount": {"type": "integer", "minimum": 1}, "totalWeight": {"type": "object"}, "originDetail": {"type": "object"}}, "required": ["associatedAccountNumber", "carrierCode", "packageCount", "totalWeight", "originDetail"]},
          "availability_request": {"type": "object"},
          "availability_override_reason": {"type": "string"},
          "confirm": {"type": "boolean", "default": false},
          "operation_id": {"type": "string"},
          "confirmation_digest": {"type": "string"}
        },
        "required": ["request"]
      }
    },
    {
      "name": "cancel_pickup",
      "description": "Preview or, after bound confirmation, cancel one FedEx pickup.",
      "parameters": {
        "type": "object",
        "properties": {
          "request": {"type": "object", "properties": {"pickupConfirmationCode": {"type": "string"}, "associatedAccountNumber": {"type": "object"}, "carrierCode": {"type": "string", "enum": ["FDXE", "FDXG"]}, "scheduledDate": {"type": "string"}, "location": {"type": "string"}}, "required": ["pickupConfirmationCode"]},
          "legacy_reason": {"type": "string"},
          "confirm": {"type": "boolean", "default": false},
          "operation_id": {"type": "string"},
          "confirmation_digest": {"type": "string"}
        },
        "required": ["request"]
      }
    }
  ]
}
